# ─── Pflicht ────────────────────────────────────────────────
# Domain, unter der die App per HTTPS erreichbar ist. Caddy holt
# automatisch das Let's-Encrypt-Zertifikat dafür.
APP_DOMAIN=app.al-daellen.ch

# Min. 32 Zeichen Zufall. Erzeugen:
#   openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_MIN_32_CHARS

# Postgres-Passwort. Erzeugen:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME


# ─── Optional ───────────────────────────────────────────────
# Defaults sind sinnvoll, nur überschreiben wenn nötig.
# POSTGRES_DB=ambardaellen
# POSTGRES_USER=ambardaellen
# APP_IMAGE=ghcr.io/daellengarnier/ambardaellen-app:latest

# Falls du die App lokal (nicht aus Docker) entwickeln willst,
# darf DATABASE_URL hier direkt gesetzt sein. Im Compose-Setup
# wird sie automatisch zusammengebaut.
# DATABASE_URL=postgres://ambardaellen:CHANGE_ME@db:5432/ambardaellen
